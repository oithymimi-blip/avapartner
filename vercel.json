{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "client",
      "framework": "vite",
      "headers": [
        {
          "source": "/AvaPartner_Company_Profile.pdf",
          "headers": [
            { "key": "Content-Type", "value": "application/pdf" },
            { "key": "Content-Disposition", "value": "inline; filename=\"AvaPartner_Company_Profile.pdf\"" },
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/(.*)",
          "destination": "https://avapartner.up.railway.app/api/$1"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
