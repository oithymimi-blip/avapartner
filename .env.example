# ========================================================
# FEXOVA ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL VALUES OR PRIVATE KEYS TO VERSION CONTROL
# ========================================================

# ---- SERVER ENVIRONMENT ----
NODE_ENV=production
PORT=4000
DB_FILE=./data.db

# Security & Authentication (REQUIRED IN PRODUCTION)
# Generate a strong 64-char secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_jwt_secret_hex

# Initial Admin Bootstrap Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_password_min_12_chars

# Allowed CORS Origins (Frontend Vercel domain and custom domains)
CORS_ORIGINS=https://fexova.vercel.app,https://fexova.com

# ---- CRYPTO / BLOCKCHAIN (BEP20 / BSC) ----
BSC_RPC_URL=https://bsc-dataseed.binance.org/
FACTORY_ADDRESS=0x2a6297E25afF65aA59603951f6454454727C2d59
HOT_WALLET_ADDRESS=0x_your_safe_cold_or_hot_wallet_address_here
ADMIN_PRIVATE_KEY=your_bsc_operator_private_key_here

# ---- EMAIL / SMTP (OTP & Password Reset) ----
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_email_smtp_password

# ---- FRONTEND (Set in Vercel Environment Variables) ----
# VITE_API_BASE=https://api.yourdomain.com
