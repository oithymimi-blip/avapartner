# ========================================================
# AVAPARTNER CONFIGURATION TEMPLATE
# DO NOT COMMIT SENSITIVE SECRETS TO GITHUB
# ========================================================

# ---- SERVER CONFIGURATION ----
NODE_ENV=production
PORT=4000
DB_FILE=./data.db

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_jwt_secret_hex

# Initial Admin Bootstrap Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password_min_12_chars

# Allowed CORS Origins (Localhost & Vercel deployment)
CORS_ORIGINS=http://localhost:5173,https://avapartner.vercel.app

# ---- CRYPTO / BLOCKCHAIN (BEP20 / BSC) ----
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSCSCAN_API_KEY=your_bscscan_api_key_here
FACTORY_ADDRESS=0x2a6297E25afF65aA59603951f6454454727C2d59
HOT_WALLET_ADDRESS=your_hot_wallet_address_here
ADMIN_PRIVATE_KEY=your_admin_private_key_here
